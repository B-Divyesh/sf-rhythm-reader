{
  "name": "rhythm-reader",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
